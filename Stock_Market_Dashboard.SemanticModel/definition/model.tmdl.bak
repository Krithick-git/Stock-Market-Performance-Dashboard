model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode"]

annotation PBIDesktopVersion = 2.137.952.0 (24.10)

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ['company_metadata', 'stock_market_processed', 'risk_return_summary', 'correlation_pairs', 'sector_summary', 'ml_model_evaluation', 'ml_predictions', 'ml_trend_projections']

ref cultureInfo en-US



ref table company_metadata

ref table stock_market_processed

ref table risk_return_summary

ref table correlation_pairs

ref table sector_summary

ref table ml_model_evaluation

ref table ml_predictions

ref table ml_trend_projections