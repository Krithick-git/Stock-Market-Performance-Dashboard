table stock_market_processed
	lineageTag: 3392eec6-e113-4695-9fa9-8096490bfbc6

	measure 'Latest Market Price' = VAR LastDateVal = MAX(stock_market_processed[Date]) RETURN CALCULATE(MAX(stock_market_processed[Close]), stock_market_processed[Date] = LastDateVal)
		formatString: "₹#,##0.00"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110001

	measure '20-Day Moving Average' = AVERAGE(stock_market_processed[SMA_20])
		formatString: "₹#,##0.00"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110002

	measure 'Monthly Return %' = AVERAGE(stock_market_processed[Monthly_Return_Pct])
		formatString: "+0.00%;-0.00%;0.00%"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110003

	measure '20-Day Volatility %' = AVERAGE(stock_market_processed[Volatility_20])
		formatString: "0.00%"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110004

	measure 'Total Trading Volume' = SUM(stock_market_processed[Volume])
		formatString: "#,##0"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110005

	measure 'Avg Daily Volume' = AVERAGE(stock_market_processed[Volume])
		formatString: "#,##0"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110006

	measure 'Max Drawdown %' = MIN(stock_market_processed[Drawdown_Pct])
		formatString: "0.00%"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110007

