	partition stock_market_processed = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:\Users\admin\Documents\stock market\data\processed\stock_market_processed.csv"),[Delimiter=",", Columns=27, Encoding=65001, QuoteStyle=QuoteStyle.None]),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					#"Replaced Value" = Table.ReplaceValue(#"Promoted Headers","NA",null,Replacer.ReplaceValue,{"Date", "Ticker", "Company", "Sector", "Open", "High", "Low", "Close", "Volume", "Daily_Return_Pct", "Return_Type", "Monthly_Return_Pct", "Monthly_Return_Type", "SMA_20", "SMA_50", "Volatility_20", "Annualized_Volatility_20", "Volume_SMA_20", "Cumulative_Return_Pct", "Cumulative_Peak", "Drawdown_Pct", "Year", "Month", "Month_Name", "Year_Month", "Quarter", "Day_of_Week"}),
					#"Changed Type" = Table.TransformColumnTypes(#"Replaced Value",{  {"Open", type number}, {"High", type number}, {"Low", type number}, {"Close", type number}, {"Volume", type number}, {"Daily_Return_Pct", type number}, {"Monthly_Return_Pct", type number}, {"SMA_20", type number}, {"SMA_50", type number}, {"Volatility_20", type number}, {"Annualized_Volatility_20", type number}, {"Volume_SMA_20", type number}, {"Cumulative_Return_Pct", type number}, {"Cumulative_Peak", type number}, {"Drawdown_Pct", type number}, {"Year", type number}, {"Month", type number}   })
				in
					#"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
measure 'Latest Market Price' = CALCULATE(MAX(stock_market_processed[Close]), LASTDATE(stock_market_processed[Date]))
		formatString: "₹#,##0.00"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110001

	measure '20-Day Moving Average' = AVERAGE(stock_market_processed[SMA_20])
		formatString: "₹#,##0.00"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110002

	measure 'Monthly Return %' = AVERAGE(stock_market_processed[Monthly_Return_Pct])
		formatString: "+0.00%;-0.00%;0.00%"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110003

	measure '20-Day Volatility %' = AVERAGE(stock_market_processed[Volatility_20])
		formatString: "0.00%"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110004

	measure 'Total Trading Volume' = SUM(stock_market_processed[Volume])
		formatString: "#,##0"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110005

	measure 'Avg Daily Volume' = AVERAGE(stock_market_processed[Volume])
		formatString: "#,##0"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110006

	measure 'Max Drawdown %' = MIN(stock_market_processed[Drawdown_Pct])
		formatString: "0.00%"
		lineageTag: 7a1d1e4c-1b77-4b71-b0e2-2a7e78110007
