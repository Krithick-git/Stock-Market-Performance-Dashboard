{
  "name": "StockMarketDarkTheme",
  "dataColors": [
    "#38BDF8",
    "#10B981",
    "#EF4444",
    "#3B82F6",
    "#F59E0B",
    "#8B5CF6",
    "#6366F1",
    "#EC4899"
  ],
  "background": "#0B132B",
  "foreground": "#F8FAFC",
  "tableAccent": "#38BDF8",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#1C2541" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": { "solid": { "color": "#334155" } },
            "width": 1,
            "show": true
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#CBD5E1" } },
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#94A3B8" } },
            "titleColor": { "solid": { "color": "#E2E8F0" } }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#94A3B8" } },
            "titleColor": { "solid": { "color": "#E2E8F0" } },
            "gridlineColor": { "solid": { "color": "#334155" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#38BDF8" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#94A3B8" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
